# Clé API Claude (https://console.anthropic.com). Sans clé, seuls les adaptateurs/parseurs sont utilisés.
ANTHROPIC_API_KEY=
# Modèle utilisé pour l'extraction (défaut : claude-opus-5-5)
# LOCCOMPARE_MODEL=claude-opus-5-5
# Chemin d'un Chromium déjà installé (sinon : npx playwright-core install chromium)
# CHROMIUM_PATH=
